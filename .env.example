# ---------------------------------------------------------------------------
# Live Classroom Survey - Environment Configuration Template
# Copy this file to `.env` in `backend/` (or repo root, see backend/src/config.js)
# and fill in real values. NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
PARTICIPANT_TOKEN_SECRET=replace-with-another-long-random-string

# CORS
CORS_ORIGIN=https://localhost:3000

# Storage engine: "json" (default, zero native deps) or "sqlite" (better-sqlite3)
STORAGE_ENGINE=json
DATA_DIR=./data

# AI Synthesis provider: "mock" (default, offline/deterministic), "anthropic", or "openai"
SYNTHESIS_PROVIDER=mock

# anthropic: set AI_API_KEY to your Anthropic API key (or leave empty to use
#            ANTHROPIC_API_KEY / an `ant auth login` profile). AI_MODEL defaults
#            to claude-opus-5; AI_EFFORT (low|medium|high) defaults to low.
# openai:    AI_API_KEY + AI_API_BASE_URL + AI_MODEL (e.g. gpt-4o-mini)
AI_API_KEY=
AI_MODEL=
AI_EFFORT=low
AI_API_BASE_URL=https://api.openai.com/v1

# Synthesis batching controls (incremental rolling summarization)
SYNTHESIS_BATCH_SIZE=5
SYNTHESIS_BATCH_INTERVAL_MS=8000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
